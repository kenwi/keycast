{
  "schemaVersion": 1,
  "id": "local.keycast",
  "name": "Keycast",
  "version": "1.0.0",
  "author": "kenwi",
  "description": "On-screen overlay of currently pressed keys, for screen recordings",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Keycast",
    "description": "Show currently pressed keys in a corner overlay while recording",
    "category": "Capture",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "overlayEnabled": false,
      "showWhileRecording": false,
      "frameEnabled": false,
      "roundingEnabled": true,
      "rounding": 8,
      "vertical": "bottom",
      "horizontal": "middle",
      "padding": 24,
      "scale": 1,
      "scaleCustom": false,
      "lingerMs": 600,
      "actionEnabled": true,
      "previewEnabled": true,
      "actionPosition": "above",
      "fontFamily": "shell",
      "colorTheme": "shell",
      "backgroundColor": "#1A1A1A",
      "borderColor": "#6E6E6E",
      "fontColor": "#F5F5F5",
      "mouseEnabled": true,
      "mouseLeft": true,
      "mouseRight": true,
      "mouseMiddle": true,
      "mouseBack": false,
      "mouseForward": false,
      "mouseWheelUp": true,
      "mouseWheelDown": true,
      "mouseWheelLeft": false,
      "mouseWheelRight": false,
      "mouseRequireKeys": false,
      "mouseRipple": true,
      "mouseRippleScroll": false,
      "mouseRippleFollow": false,
      "mouseRippleFade": false,
      "mousePlacement": "inline",
      "mouseLabelStyle": "short",
      "mouseLingerMs": 500,
      "mouseRippleSize": 36,
      "mouseRippleMs": 400
    },
    "schema": [
      {
        "key": "overlayEnabled",
        "type": "boolean",
        "label": "Show pressed keys",
        "defaultValue": false
      },
      {
        "key": "showWhileRecording",
        "type": "boolean",
        "label": "Show while recording",
        "defaultValue": false
      },
      {
        "key": "frameEnabled",
        "type": "boolean",
        "label": "Outer box",
        "description": "Background and border around the keycaps",
        "defaultValue": false
      },
      {
        "key": "roundingEnabled",
        "type": "boolean",
        "label": "Rounded corners",
        "defaultValue": true
      },
      {
        "key": "rounding",
        "type": "integer",
        "label": "Corner radius (px)",
        "min": 0,
        "max": 32,
        "defaultValue": 8
      },
      {
        "key": "vertical",
        "type": "enum",
        "label": "Vertical edge",
        "options": ["top", "middle", "bottom"],
        "defaultValue": "bottom"
      },
      {
        "key": "horizontal",
        "type": "enum",
        "label": "Horizontal edge",
        "options": ["left", "middle", "right"],
        "defaultValue": "middle"
      },
      {
        "key": "padding",
        "type": "integer",
        "label": "Edge padding (px)",
        "description": "Distance from the chosen edge. Ignored on an axis set to middle.",
        "min": 0,
        "max": 400,
        "defaultValue": 24
      },
      {
        "key": "scale",
        "type": "string",
        "label": "Overlay scale",
        "description": "Preset 1 / 1.25 / 1.5 / 1.75 / 2, or 0.5-5 when custom",
        "defaultValue": "1"
      },
      {
        "key": "scaleCustom",
        "type": "boolean",
        "label": "Custom overlay scale",
        "defaultValue": false
      },
      {
        "key": "lingerMs",
        "type": "integer",
        "label": "Linger after release (ms)",
        "min": 0,
        "max": 2000,
        "step": 50,
        "defaultValue": 600
      },
      {
        "key": "actionEnabled",
        "type": "boolean",
        "label": "Show shortcut action",
        "description": "Bind description from Hyprland, same source as Super+K",
        "defaultValue": true
      },
      {
        "key": "previewEnabled",
        "type": "boolean",
        "label": "Preview keypress",
        "description": "Show a sample hotkey on the overlay while settings are open",
        "defaultValue": true
      },
      {
        "key": "actionPosition",
        "type": "enum",
        "label": "Action placement",
        "options": ["above", "below"],
        "defaultValue": "above"
      },
      {
        "key": "fontFamily",
        "type": "string",
        "label": "Overlay font",
        "description": "shell uses the Omarchy UI font, or any installed family",
        "defaultValue": "shell"
      },
      {
        "key": "colorTheme",
        "type": "enum",
        "label": "Color theme",
        "options": ["shell", "dark", "light", "contrast", "nord", "mocha", "gold", "neon", "matrix", "vapor", "cyber", "ember", "ice", "custom"],
        "defaultValue": "shell"
      },
      {
        "key": "backgroundColor",
        "type": "string",
        "label": "Background color",
        "defaultValue": "#1A1A1A"
      },
      {
        "key": "borderColor",
        "type": "string",
        "label": "Border color",
        "defaultValue": "#6E6E6E"
      },
      {
        "key": "fontColor",
        "type": "string",
        "label": "Font color",
        "defaultValue": "#F5F5F5"
      },
      {
        "key": "mouseEnabled",
        "type": "boolean",
        "label": "Show mouse",
        "defaultValue": true
      },
      {
        "key": "mouseLeft",
        "type": "boolean",
        "label": "Left button",
        "defaultValue": true
      },
      {
        "key": "mouseRight",
        "type": "boolean",
        "label": "Right button",
        "defaultValue": true
      },
      {
        "key": "mouseMiddle",
        "type": "boolean",
        "label": "Middle button",
        "defaultValue": true
      },
      {
        "key": "mouseBack",
        "type": "boolean",
        "label": "Back button",
        "defaultValue": false
      },
      {
        "key": "mouseForward",
        "type": "boolean",
        "label": "Forward button",
        "defaultValue": false
      },
      {
        "key": "mouseWheelUp",
        "type": "boolean",
        "label": "Scroll up",
        "defaultValue": true
      },
      {
        "key": "mouseWheelDown",
        "type": "boolean",
        "label": "Scroll down",
        "defaultValue": true
      },
      {
        "key": "mouseWheelLeft",
        "type": "boolean",
        "label": "Scroll left",
        "defaultValue": false
      },
      {
        "key": "mouseWheelRight",
        "type": "boolean",
        "label": "Scroll right",
        "defaultValue": false
      },
      {
        "key": "mouseRequireKeys",
        "type": "boolean",
        "label": "Only while a key is shown",
        "defaultValue": false
      },
      {
        "key": "mouseRipple",
        "type": "boolean",
        "label": "Ripple at the cursor",
        "defaultValue": true
      },
      {
        "key": "mouseRippleScroll",
        "type": "boolean",
        "label": "Ripple on scroll",
        "defaultValue": false
      },
      {
        "key": "mouseRippleFollow",
        "type": "boolean",
        "label": "Follow a drag",
        "defaultValue": false
      },
      {
        "key": "mouseRippleFade",
        "type": "boolean",
        "label": "Fade out",
        "defaultValue": false
      },
      {
        "key": "mousePlacement",
        "type": "enum",
        "label": "Mouse placement",
        "options": ["inline", "above", "below"],
        "defaultValue": "inline"
      },
      {
        "key": "mouseLabelStyle",
        "type": "enum",
        "label": "Mouse labels",
        "options": ["short", "name"],
        "defaultValue": "short"
      },
      {
        "key": "mouseLingerMs",
        "type": "integer",
        "label": "Mouse linger (ms)",
        "min": 0,
        "max": 2000,
        "defaultValue": 500
      },
      {
        "key": "mouseRippleSize",
        "type": "integer",
        "label": "Ripple size (px)",
        "min": 8,
        "max": 160,
        "defaultValue": 36
      },
      {
        "key": "mouseRippleMs",
        "type": "integer",
        "label": "Ripple linger (ms)",
        "min": 100,
        "max": 2000,
        "defaultValue": 400
      }
    ]
  }
}
